# Docker Compose 配置；install.sh 会在首次安装时生成随机数据库密码。
ARTEX_IMAGE=ghcr.io/x0rz4/artemis
# latest = 稳定版本；edge = main 分支；也可指定 v2.3.0 等已发布标签。
ARTEX_TAG=latest
ARTEX_BIND=127.0.0.1
ARTEX_PORT=8787
ARTEX_PROXY_PORT=8788
POSTGRES_USER=artemis
POSTGRES_PASSWORD=
POSTGRES_DB=artemis

# 本地编译 + Docker 数据库模式使用；数据库仅绑定本机。
ARTEX_PG_PORT=5433

# 可选模型配置，也可以全部留空，在 UI 中添加。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 源码镜像构建可选覆盖；不影响运行时配置。
# ARTEX_BUILD_VERSION=2.3.0
# GOPROXY=https://proxy.golang.org,direct
# NPM_REGISTRY=https://registry.npmjs.org
